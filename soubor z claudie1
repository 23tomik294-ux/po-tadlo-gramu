 <!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>Track Your Deals — Žito</title>
<link rel="manifest" href="data:application/json;charset=utf-8,%7B%22name%22%3A%22Track%20Your%20Deals%20%E2%80%94%20%C5%BDito%22%2C%22short_name%22%3A%22%C5%BDito%22%2C%22start_url%22%3A%22.%2F%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23070709%22%2C%22theme_color%22%3A%22%23E8272A%22%2C%22orientation%22%3A%22portrait%22%2C%22icons%22%3A%5B%7B%22src%22%3A%22icon-192.png%22%2C%22sizes%22%3A%22192x192%22%2C%22type%22%3A%22image%2Fpng%22%7D%2C%7B%22src%22%3A%22icon-512.png%22%2C%22sizes%22%3A%22512x512%22%2C%22type%22%3A%22image%2Fpng%22%7D%5D%7D">
<meta name="theme-color" content="#E8272A">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Žito">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#070709;
  --bg1:#0F0F13;
  --bg2:#17171E;
  --bg3:#1F1F28;
  --border:rgba(255,255,255,0.06);
  --border2:rgba(255,255,255,0.11);
  --red:#E8272A;
  --red-dim:rgba(232,39,42,0.13);
  --red-glow:rgba(232,39,42,0.4);
  --text:#F4F3FA;
  --text2:#8A8896;
  --text3:#4A4857;
  --green:#3DBA7A;
  --green-dim:rgba(61,186,122,0.13);
  --lcd:#FF9B40;
  --lcd-bg:#09080A;
  --mono:'JetBrains Mono',monospace;
  --sans:'Outfit',sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0;}
html{height:100%;background:#070709;}
body{
  font-family:var(--sans);
  background:var(--bg);
  color:var(--text);
  min-height:100%;
  width:100%;
  max-width:480px;
  margin:0 auto;
  overflow-x:hidden;
}
::-webkit-scrollbar{width:0;}

/* HEADER */
.hdr{
  display:flex;align-items:center;justify-content:space-between;
  padding:12px 16px 12px;
  background:rgba(7,7,9,0.92);
  backdrop-filter:blur(12px);
  position:sticky;top:0;z-index:10;
  border-bottom:1px solid var(--border);
}
.logo{display:flex;align-items:center;gap:10px;}
.logo img{
  height:36px;width:36px;object-fit:contain;border-radius:9px;
  box-shadow:0 0 14px rgba(232,39,42,0.35);
}
.logo-name{font-size:14px;font-weight:800;letter-spacing:-0.01em;color:#fff;line-height:1.15;}
.logo-name span{color:var(--red);}
.logo-sub{font-size:10px;color:var(--text3);letter-spacing:0.04em;margin-top:1px;}
.hdr-right{display:flex;align-items:center;gap:8px;}
.hdr-chip{font-family:var(--mono);font-size:10px;color:var(--text3);background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:5px 10px;}
.hdr-dot{width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red-glow),0 0 16px rgba(232,39,42,0.2);}

/* PAGE */
.page{padding:12px clamp(10px,3vw,20px) 60px;}
.sec{font-size:10px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--text3);padding:0 2px 7px;}

/* CARD */
.card{background:var(--bg1);border:1px solid var(--border);border-radius:20px;overflow:hidden;margin-bottom:10px;}
.card-p{padding:16px;}

/* FORM */
.fields{display:flex;gap:8px;}
.field-wrap{flex:1;}
.field-lbl{font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text3);margin-bottom:6px;}
.field{display:flex;align-items:center;background:var(--bg2);border:1.5px solid var(--border);border-radius:13px;padding:0 14px;transition:border-color .15s;}
.field:focus-within{border-color:rgba(232,39,42,0.45);}
.field input{flex:1;min-width:0;background:transparent;border:none;outline:none;color:var(--text);font-family:var(--mono);font-size:19px;font-weight:500;padding:13px 0;}
.field input::placeholder{color:var(--text3);}
.field input::-webkit-outer-spin-button,.field input::-webkit-inner-spin-button{-webkit-appearance:none;}
.field input[type=number]{-moz-appearance:textfield;}
.field-unit{font-size:11px;font-weight:600;color:var(--text3);margin-left:8px;}
.btn-row{display:flex;gap:8px;margin-top:10px;}
.btn{font-family:var(--sans);font-weight:700;font-size:14px;border:none;cursor:pointer;border-radius:13px;padding:14px 0;flex:1;transition:transform .1s,opacity .12s;letter-spacing:0.01em;}
.btn:active{transform:scale(0.97);opacity:.85;}
.btn-red{background:var(--red);color:#fff;box-shadow:0 4px 18px rgba(232,39,42,0.28);}
.btn-ghost{background:var(--bg2);color:var(--text2);border:1.5px solid var(--border2);flex:0 0 auto;padding:14px 18px;}
.btn-sell{background:linear-gradient(135deg,#B91F22,#E8272A);color:#fff;box-shadow:0 4px 18px rgba(232,39,42,0.28);}

/* COMPACT BUY ROW */
.buy-row{display:flex;align-items:center;gap:0;padding:10px 12px;background:var(--bg2);border-radius:16px;margin:10px 12px 10px;}
.buy-field{display:flex;align-items:center;flex:1;min-width:0;}
.buy-field input{flex:1;min-width:0;background:transparent;border:none;outline:none;color:var(--text);font-family:var(--mono);font-size:18px;font-weight:500;padding:9px 0;}
.buy-field input::placeholder{color:var(--text3);}
.buy-field input::-webkit-outer-spin-button,.buy-field input::-webkit-inner-spin-button{-webkit-appearance:none;}
.buy-field input[type=number]{-moz-appearance:textfield;}
.buy-unit{font-size:11px;font-weight:700;color:var(--text3);padding:0 10px 0 4px;letter-spacing:0.06em;}
.buy-sep{width:1px;height:28px;background:var(--border2);flex-shrink:0;margin:0 4px;}
.buy-btn{flex:0 0 auto;padding:10px 20px;border-radius:12px;font-size:18px;font-weight:800;min-width:44px;}
.buy-reset{flex:0 0 auto;padding:10px 14px;border-radius:12px;font-size:16px;min-width:40px;}

/* SCALE ROW */
.scale-row{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:18px 10px 14px;}
.knob-wrap{display:flex;flex-direction:column;align-items:center;flex:1;}
.knob-outer{position:relative;width:clamp(88px,25vw,120px);height:clamp(88px,25vw,120px);}

/* 3D KNOB */
.knob{
  width:100%;height:100%;border-radius:50%;
  position:relative;touch-action:none;cursor:grab;
  background:radial-gradient(circle at 33% 27%, #2D2A3D 0%, #1A1825 45%, #0D0C13 100%);
  box-shadow:
    inset 3px 4px 9px rgba(255,255,255,0.12),
    inset -3px -4px 10px rgba(0,0,0,0.88),
    0 12px 36px rgba(0,0,0,0.72),
    0 4px 10px rgba(0,0,0,0.5),
    0 0 0 1.5px rgba(255,255,255,0.06),
    0 0 0 3px rgba(0,0,0,0.65);
}
.knob:active{cursor:grabbing;}
.knob::before{
  content:'';position:absolute;inset:9px;border-radius:50%;
  background:radial-gradient(circle at 34% 26%, #222030 0%, #131119 55%, #080710 100%);
  box-shadow:inset 1px 2px 5px rgba(255,255,255,0.06),inset -1px -2px 6px rgba(0,0,0,0.92),inset 0 0 0 1px rgba(0,0,0,0.5);
}
.knob-ticks{position:absolute;inset:0;pointer-events:none;}
.knob-tick{
  position:absolute;left:50%;top:2.5px;width:2px;height:6px;
  background:linear-gradient(rgba(255,255,255,0.13),rgba(255,255,255,0.01));
  border-radius:1px;
  transform-origin:1px clamp(43px,12.5vw,59px);
}
.knob-icon-el{
  position:absolute;inset:0;pointer-events:none;z-index:2;
  display:flex;align-items:flex-start;justify-content:center;
  padding-top:clamp(13px,3.6vw,17px);
}
.knob-icon-el svg{filter:drop-shadow(0 1px 3px rgba(0,0,0,0.8));}
#knobGrams .knob-icon-el svg{opacity:0.85;}
#knobKc .knob-icon-el svg{opacity:0.85;}
.knob-needle{
  position:absolute;left:50%;top:50%;
  width:2px;height:clamp(26px,7.5vw,38px);
  background:linear-gradient(#fff,rgba(232,39,42,0.85));
  border-radius:2px;
  transform-origin:50% 100%;
  transform:translate(-50%,-100%) rotate(0deg);
  box-shadow:0 0 7px rgba(255,60,60,0.85);
  z-index:4;
}
.knob-hub{
  position:absolute;left:50%;top:50%;
  width:clamp(15px,4vw,19px);height:clamp(15px,4vw,19px);
  border-radius:50%;
  transform:translate(-50%,-50%);
  background:radial-gradient(circle at 36% 28%,#FF5050,#C0222A 60%,#880D12);
  box-shadow:inset 0 1px 3px rgba(255,140,140,0.4),inset 0 -1px 4px rgba(0,0,0,0.65),0 0 0 2px rgba(0,0,0,0.75),0 0 10px rgba(232,39,42,0.5);
  z-index:5;transition:box-shadow .12s;
}
.knob.pulse .knob-hub{box-shadow:inset 0 1px 3px rgba(255,140,140,0.4),inset 0 -1px 4px rgba(0,0,0,0.65),0 0 0 2px rgba(0,0,0,0.75),0 0 22px rgba(232,39,42,1),0 0 44px rgba(232,39,42,0.3);}
.knob-val{font-family:var(--mono);font-weight:600;font-size:clamp(14px,4vw,20px);color:var(--text);margin-top:10px;text-align:center;letter-spacing:-0.02em;}
.knob-unit{font-size:10px;font-weight:500;color:var(--text3);letter-spacing:0.08em;text-transform:uppercase;margin-top:3px;}
.dir-tags{display:flex;gap:4px;margin-top:7px;}
.dir-tag{font-family:var(--mono);font-size:9px;padding:2px 7px;border-radius:6px;color:var(--text3);border:1px solid var(--border);transition:all .12s;}
.dir-tag.active{color:#fff;background:var(--red);border-color:var(--red);}

/* LCD */
.lcd-wrap{flex:0 0 clamp(76px,20vw,100px);}
.lcd{
  background:var(--lcd-bg);border:1px solid rgba(0,0,0,0.9);border-radius:14px;
  padding:12px 6px 10px;text-align:center;
  box-shadow:inset 0 3px 10px rgba(0,0,0,0.92),inset 0 0 0 1px rgba(255,155,64,0.03),0 0 0 1px rgba(255,255,255,0.04),0 4px 14px rgba(0,0,0,0.5);
}
.lcd-lbl{font-family:var(--mono);font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,155,64,0.22);}
.lcd-val{font-family:var(--mono);font-size:clamp(14px,4.3vw,20px);font-weight:600;color:var(--lcd);text-shadow:0 0 14px rgba(255,155,64,0.65),0 0 28px rgba(255,155,64,0.2);margin:6px 0 4px;letter-spacing:-0.02em;line-height:1;}
.lcd-unit{font-family:var(--mono);font-size:8px;letter-spacing:0.1em;color:rgba(255,155,64,0.22);text-transform:uppercase;}

.divider{height:1px;background:var(--border);}
.scale-actions{display:flex;gap:8px;padding:12px 12px 14px;}

/* BILANCE */
.bil-row{display:flex;justify-content:space-between;align-items:flex-start;padding:14px 16px 8px;}
.bil-label{font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text3);margin-bottom:5px;}
.bil-val{font-family:var(--mono);font-size:clamp(18px,5vw,24px);font-weight:600;color:var(--text);letter-spacing:-0.03em;}
.bil-val.pos{color:var(--green);}
.bil-val.neg{color:var(--red);}
.chart-wrap{position:relative;height:72px;}
#chart{width:100%;height:72px;display:block;}
.chart-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--text3);}

/* HISTORY */
.hist-hdr{display:flex;align-items:center;justify-content:space-between;padding:4px 2px 8px;gap:8px;}
.hist-title{font-size:14px;font-weight:700;color:var(--text);}
.hist-count{font-family:var(--mono);font-size:10px;color:var(--text3);flex:1;}
.btn-reset-all{
  background:transparent;border:1.5px solid rgba(232,39,42,0.3);
  color:var(--red);font-family:var(--sans);font-size:11px;font-weight:700;
  padding:5px 12px;border-radius:8px;cursor:pointer;
  transition:background .12s,border-color .12s;letter-spacing:0.02em;
}
.btn-reset-all:active{background:var(--red-dim);border-color:var(--red);}
.empty{padding:28px 16px;text-align:center;font-size:13px;color:var(--text3);border:1.5px dashed var(--border);border-radius:14px;}
.row{display:flex;align-items:center;gap:8px;padding:11px 14px;border-bottom:1px solid var(--border);}
.row:last-child{border-bottom:none;}
.row-num{font-family:var(--mono);font-size:10px;color:var(--text3);width:18px;flex-shrink:0;}
.row-tag{font-family:var(--mono);font-size:9px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;padding:3px 7px;border-radius:7px;flex-shrink:0;}
.row-tag.buy{color:var(--red);background:var(--red-dim);border:1px solid rgba(232,39,42,0.18);}
.row-tag.sell{color:var(--green);background:var(--green-dim);border:1px solid rgba(61,186,122,0.18);}
.row-main{flex:1;min-width:0;}
.row-g{font-weight:600;font-size:13px;color:var(--text);}
.row-meta{font-size:10px;color:var(--text3);margin-top:1px;font-family:var(--mono);}
.row-kc{font-family:var(--mono);font-weight:600;font-size:13px;flex-shrink:0;}
.row-kc.out{color:var(--red);}
.row-kc.in{color:var(--green);}
.row-del{background:transparent;border:none;cursor:pointer;font-size:13px;color:var(--text3);padding:4px 6px;border-radius:6px;transition:color .1s,background .1s;}
.row-del:active{color:var(--red);background:var(--red-dim);}
</style>

<script>
if('serviceWorker' in navigator){
  const swCode=`
self.addEventListener('install',e=>e.waitUntil(
  caches.open('zito-v1').then(c=>c.add('/'))
));
self.addEventListener('fetch',e=>e.respondWith(
  caches.match(e.request).then(r=>r||fetch(e.request))
));
`;
  const blob=new Blob([swCode],{type:'text/javascript'});
  navigator.serviceWorker.register(URL.createObjectURL(blob));
}
</script>
</head>
<body>

<div class="hdr">
  <div class="logo">
    <img src="data:image/jpeg;base64,